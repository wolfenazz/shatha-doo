# =============================================================================
# Dynamics 365 Connector — Environment Configuration
# -----------------------------------------------------------------------------

# Copy this file to `.env` and fill in real values for your environment.
# NEVER commit `.env` or share real credentials. Only this template is tracked.

# =============================================================================
# Base URL of your Dynamics 365 organization Web API (no trailing slash).
# Found in Power Apps > Settings > Developer resources (Environment URL).
# Example: https://contoso.api.crm.dynamics.com
D365_ORG_URL=https://<your-org>.api.crm.dynamics.com

# Azure Active Directory tenant ID that hosts the registered application.
# Found in Azure Portal > App registrations > <your app> > Overview.
D365_TENANT_ID=<azure-tenant-id>

# Application (client) ID from the Azure app registration.
D365_CLIENT_ID=<azure-app-client-id>

# Client secret generated for the app registration (certificate or secret).
# Treat this like a password: keep it out of logs, code, and Git history.
D365_CLIENT_SECRET=<azure-app-client-secret>

# Redirect URI registered for the OAuth 2.0 authorization_code flow.
# Must match exactly what is configured in the Azure app registration.
D365_REDIRECT_URI=http://localhost:3000/callback

# Dynamics 365 Web API version (optional, defaults to v9.2).
D365_API_VERSION=v9.2

# Log level (optional: debug | info | warn | error). Defaults to info.
D365_LOG_LEVEL=info

# Short-lived access token for the MCP servers (optional, non-interactive).
# For interactive use prefer the OAuth flow with the client fields above.
D365_ACCESS_TOKEN=

# OAuth alternative: refresh token for the refresh_token grant (optional).
# The connector acquires/refreshes tokens automatically and caches them in
# memory (tokens are never logged or persisted).
D365_REFRESH_TOKEN=

# OAuth authorization code (optional, one-time use).
D365_AUTH_CODE=

# OAuth scope override (optional; defaults to https://<org>/.default).
D365_SCOPE=

# Token endpoint override (optional — normally left empty; used by tests and
# the bundled offline mock sandbox to point OAuth traffic at a local server).
D365_TOKEN_URL=

# Required for every consequential connector/MCP write. The trusted host must
# issue and supply this value only after the user approves the exact operation.
D365_WRITE_APPROVAL_TOKEN=<random-write-approval-secret>

# Required bearer credential for the Streamable HTTP MCP endpoint.
MCP_API_KEY=<random-http-api-key>

# Browser origins allowed to call the HTTP MCP endpoint (comma-separated).
# Leave empty when browser access is not needed; wildcard CORS is never used.
MCP_ALLOWED_ORIGINS=https://trusted-client.example.com

# Per-IP HTTP MCP request limit per minute (optional, defaults to 120).
MCP_RATE_LIMIT_PER_MINUTE=120
