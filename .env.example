# =============================================================================
# Dynamics 365 Connector — Environment Configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values for your environment.
# NEVER commit `.env` or share real credentials. Only this template is tracked.
# (انقل هذا الملف إلى `.env` وعبّئ القيم الحقيقية — لا ترفع `.env` أو الأسرار أبداً)
# =============================================================================

# Base URL of your Dynamics 365 organization Web API (no trailing slash).
# Found in Power Apps > Settings > Developer resources (Environment URL).
# Example: https://contoso.api.crm.dynamics.com
D365_ORG_URL=https://<your-org>.api.crm.dynamics.com

# Azure Active Directory tenant ID that hosts the registered application.
# Found in Azure Portal > App registrations > <your app> > Overview.
D365_TENANT_ID=<azure-tenant-id>

# Application (client) ID from the Azure app registration.
D365_CLIENT_ID=<azure-app-client-id>

# Client secret generated for the app registration (certificate or secret).
# Treat this like a password: keep it out of logs, code, and Git history.
D365_CLIENT_SECRET=<azure-app-client-secret>

# Redirect URI registered for the OAuth 2.0 authorization_code flow.
# Must match exactly what is configured in the Azure app registration.
D365_REDIRECT_URI=http://localhost:3000/callback

# Dynamics 365 Web API version (optional, defaults to v9.2).
D365_API_VERSION=v9.2

# Log level (optional: debug | info | warn | error). Defaults to info.
D365_LOG_LEVEL=info

# Short-lived access token for the MCP stdio server (optional, non-interactive).
# For interactive use prefer the OAuth flow with the client fields above.
D365_ACCESS_TOKEN=
