{
  "name": "dynamics365-connector",
  "version": "1.1.0",
  "description": "Microsoft Dynamics 365 connector for DOO Builders League",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/src/connector.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:integration": "jest tests/integration.test.ts --runInBand",
    "lint": "eslint \"src/**/*.ts\" \"mcp/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"scripts/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"mcp/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"scripts/**/*.ts\"",
    "mcp": "node dist/mcp/server.js",
    "mcp:http": "node dist/mcp/http-server.js",
    "demo": "npm run build && node dist/scripts/demo.js",
    "start": "node dist/mcp/http-server.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.2"
  },
  "overrides": {
    "fast-uri": "^3.1.6",
    "qs": "^6.16.0"
  }
}
